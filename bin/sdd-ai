#!/usr/bin/env node
import { enableCompileCache } from 'node:module'

// Preparar TypeScript es lo que más cuesta al arrancar; la caché de Node, fuera del repo, lo evita
// desde la segunda vez. Si no se puede activar, Node lo informa en lo que devuelve, sin lanzar, y el
// binario sigue sin caché, más lento.
enableCompileCache()

// Un hook corre en cada evento de la sesión: no carga el CLI entero, solo lo que responde el evento.
if (process.argv[2] === 'hook') {
  const { runHook } = await import('../src/hooks.ts')
  const cli = process.argv[3]
  const chunks = []
  for await (const chunk of process.stdin) chunks.push(chunk)
  if (cli === 'claude' || cli === 'codex') process.stdout.write(runHook(Buffer.concat(chunks).toString('utf8'), cli))
  process.exitCode = 0
} else {
  const { main } = await import('../src/cli.ts')
  const { code, out } = await main(process.argv.slice(2), process.env, process.cwd())
  process.stdout.write(`${JSON.stringify(out)}\n`)
  process.exitCode = code
}
